<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{block title}Document{/block}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/htmx.min.js"></script>
  <script src="/js/_hyperscript.min.js"></script>
</head>
<body>

  <div class="layout">
    <aside class="sidebar">
      <nav _="
        init
        for link in <a/> in me
          if link.pathname is window.location.pathname
            call link.setAttribute('aria-current', 'page')
          end
        end
      ">

        <ul>
          <li><strong>Slim App</strong></li>
        </ul>

        <ul>
          <li><a href="/">ホーム</a></li>
          <li><a href="/todo">TODO</a></li>
        </ul>
      
      </nav>
    </aside>

    <main class="content">
      {include content}
    </main>

  </div>
</body>
</html>
