<template x-if="phase === 'setup'">
  <form class="study-setup" @submit.prevent="start()">
    <h2>学習設定</h2>

    <label>
      枚数
      <input type="number" min="0" x-model="limit" placeholder="0、または未入力で全カード">
    </label>

    <p>該当 <span x-text="allCards.length"></span> 件 / 出題 <span x-text="studyCount"></span> 件</p>

    <button type="submit">開始</button>
  </form>
</template>
